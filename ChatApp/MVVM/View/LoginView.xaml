<Window x:Class="ChatApp.MVVM.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp" xmlns:viewmodel="clr-namespace:ChatApp.MVVM.ViewModel"
        mc:Ignorable="d"
        Title="LoginView"
        Height="400" Width="300"
        Background="#36393F"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseDown="Border_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Window.Visibility>
        <Binding Path="IsVisible" Mode="TwoWay" Converter="{StaticResource BoolToVisibility}"/>
    </Window.Visibility>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="#252525"
                MouseDown="Border_MouseDown">
            
            <Grid HorizontalAlignment="Stretch">
                <Label Content="Login"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="DemiBold"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"/>

                <Button Content="𐌗"
                        Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>
            
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Margin="60">
            
            <Label Content="Username:"
                   Foreground="WhiteSmoke"
                   FontWeight="DemiBold"
                   FontSize="14"/>
            <TextBox Background="Transparent"
                     TextWrapping="Wrap"
                     Height="25"
                     FontSize="13"
                     BorderThickness="0,0,0,1"
                     Foreground="DarkGray"
                     CaretBrush="LightGray"
                     Margin="5,10,0,0"
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            
            <Label Content="Password:"
                   Foreground="WhiteSmoke"
                   FontWeight="DemiBold"
                   FontSize="14"
                   Margin="0,30,0,0"/>
            <TextBox Background="Transparent"
                     TextWrapping="Wrap"
                     Height="25"
                     FontSize="13"
                     BorderThickness="0,0,0,1"
                     Foreground="DarkGray"
                     CaretBrush="LightGray"
                     Margin="5,10,0,0"
                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="12"
                   Margin="0,10,0,10"/>

            <Button Width="60" Height="30"
                    Content="Login"
                    FontSize="14"
                    Foreground="DarkGray"
                    Background="White"
                    Margin="10"
                    Command="{Binding ConnectToServerCommand}"/>

        </StackPanel>

    </Grid>
</Window>
